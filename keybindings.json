[
  // ════════════════════════════════════════════════════════════════
  // NAVIGATION
  // ════════════════════════════════════════════════════════════════
  { "key": "ctrl+-", "command": "workbench.action.navigateBack" },
  { "key": "ctrl+shift+-", "command": "workbench.action.navigateForward" },
  { "key": "cmd+o", "command": "workbench.action.openRecent" },

  // ════════════════════════════════════════════════════════════════
  // PICKERS — files, symbols, text
  // ════════════════════════════════════════════════════════════════
  // Cmd+P lists only open tabs, most recently used first
  {
    "key": "cmd+p",
    "command": "workbench.action.showAllEditorsByMostRecentlyUsed",
  },
  // Current file's symbols, grouped under type headings
  {
    "key": "cmd+shift+o",
    "command": "workbench.action.quickOpen",
    "args": "@:",
  },
  // Workspace-wide text search
  { "key": "alt+f", "command": "workbench.action.findInFiles" },
  // Focus the file tree, then open its filter field, from anywhere
  {
    "key": "cmd+shift+f",
    "command": "runCommands",
    "args": {
      "commands": ["workbench.files.action.focusFilesExplorer", "list.find"],
    },
  },
  // Placeholder: whole-workspace file search, now that cmd+p is open-tabs only
  // { "key": "alt+p", "command": "workbench.action.quickOpen" },
  // Placeholder: fires while typing a capital E — needs a "when" before re-enabling
  // { "key": "shift+e", "command": "workbench.action.showAllEditorsByMostRecentlyUsed" },

  // ════════════════════════════════════════════════════════════════
  // TABS
  // ════════════════════════════════════════════════════════════════
  // ── Cycle (terminal-focused: cycle terminals instead) ──
  { "key": "ctrl+tab", "command": "workbench.action.nextEditor" },
  { "key": "ctrl+shift+tab", "command": "workbench.action.previousEditor" },
  {
    "key": "ctrl+tab",
    "command": "workbench.action.terminal.focusNext",
    "when": "terminalFocus",
  },
  {
    "key": "ctrl+shift+tab",
    "command": "workbench.action.terminal.focusPrevious",
    "when": "terminalFocus",
  },
  // ── Jump by position ──
  { "key": "cmd+1", "command": "workbench.action.openEditorAtIndex1" },
  { "key": "cmd+2", "command": "workbench.action.openEditorAtIndex2" },
  { "key": "cmd+3", "command": "workbench.action.openEditorAtIndex3" },
  { "key": "cmd+4", "command": "workbench.action.openEditorAtIndex4" },
  { "key": "cmd+5", "command": "workbench.action.openEditorAtIndex5" },
  { "key": "cmd+6", "command": "workbench.action.openEditorAtIndex6" },
  { "key": "cmd+7", "command": "workbench.action.openEditorAtIndex7" },
  { "key": "cmd+8", "command": "workbench.action.openEditorAtIndex8" },
  { "key": "cmd+9", "command": "workbench.action.openEditorAtIndex9" },
  // ── Pin, close, reopen ──
  {
    "key": "cmd+alt+p",
    "command": "workbench.action.pinEditor",
    "when": "!activeEditorIsPinned",
  },
  {
    "key": "cmd+alt+p",
    "command": "workbench.action.unpinEditor",
    "when": "activeEditorIsPinned",
  },
  { "key": "cmd+alt+e", "command": "workbench.action.closeOtherEditors" },
  { "key": "cmd+alt+r", "command": "workbench.action.closeEditorsToTheRight" },
  { "key": "shift+cmd+t", "command": "workbench.action.reopenClosedEditor" },

  // ════════════════════════════════════════════════════════════════
  // SPLITS & LAYOUT
  // ════════════════════════════════════════════════════════════════
  // ── Create (chords: cmd+r, then the second key) ──
  { "key": "cmd+r cmd+shift+d", "command": "workbench.action.splitEditorDown" },
  { "key": "cmd+r cmd+d", "command": "workbench.action.splitEditorRight" },
  // ── Focus by number (9 = last; no ninth-group command) ──
  { "key": "ctrl+1", "command": "workbench.action.focusFirstEditorGroup" },
  { "key": "ctrl+2", "command": "workbench.action.focusSecondEditorGroup" },
  { "key": "ctrl+3", "command": "workbench.action.focusThirdEditorGroup" },
  { "key": "ctrl+4", "command": "workbench.action.focusFourthEditorGroup" },
  { "key": "ctrl+5", "command": "workbench.action.focusFifthEditorGroup" },
  { "key": "ctrl+6", "command": "workbench.action.focusSixthEditorGroup" },
  { "key": "ctrl+7", "command": "workbench.action.focusSeventhEditorGroup" },
  { "key": "ctrl+8", "command": "workbench.action.focusEighthEditorGroup" },
  { "key": "ctrl+9", "command": "workbench.action.focusLastEditorGroup" },
  // ── Move tab to split 1–4 (split must already exist) ──
  // 2–4 use moveActiveEditor: Cursor's numbered move commands are broken
  {
    "key": "ctrl+shift+1",
    "command": "workbench.action.moveEditorToFirstGroup",
  },
  {
    "key": "ctrl+shift+2",
    "command": "moveActiveEditor",
    "args": { "to": "position", "by": "group", "value": 2 },
  },
  {
    "key": "ctrl+shift+3",
    "command": "moveActiveEditor",
    "args": { "to": "position", "by": "group", "value": 3 },
  },
  {
    "key": "ctrl+shift+4",
    "command": "moveActiveEditor",
    "args": { "to": "position", "by": "group", "value": 4 },
  },
  // ── Move tab to the neighboring split ──
  { "key": "ctrl+w left", "command": "workbench.action.moveEditorToLeftGroup" },
  {
    "key": "ctrl+w right",
    "command": "workbench.action.moveEditorToRightGroup",
  },
  // ── Split proportions ──
  { "key": "ctrl+0", "command": "workbench.action.evenEditorWidths" },
  {
    "key": "cmd+r cmd+[",
    "command": "vscode.setEditorLayout",
    "args": { "orientation": 0, "groups": [{ "size": 0.7 }, { "size": 0.3 }] },
  },
  {
    "key": "cmd+r cmd+]",
    "command": "vscode.setEditorLayout",
    "args": { "orientation": 0, "groups": [{ "size": 0.3 }, { "size": 0.7 }] },
  },
  // Placeholder: move tab within a split (keys now used by resize)
  // { "key": "cmd+alt+left", "command": "workbench.action.moveEditorLeftInGroup" },
  // { "key": "cmd+alt+right", "command": "workbench.action.moveEditorRightInGroup" },

  // ════════════════════════════════════════════════════════════════
  // VIEW SIZE & ZOOM
  // ════════════════════════════════════════════════════════════════
  // ── Resize focused view: both axes ──
  { "key": "cmd+;", "command": "workbench.action.decreaseViewSize" },
  { "key": "cmd+'", "command": "workbench.action.increaseViewSize" },
  // ── Resize focused view: one axis ──
  { "key": "alt+cmd+left", "command": "workbench.action.decreaseViewWidth" },
  { "key": "alt+cmd+right", "command": "workbench.action.increaseViewWidth" },
  { "key": "alt+cmd+down", "command": "workbench.action.increaseViewHeight" },
  { "key": "alt+cmd+up", "command": "workbench.action.decreaseViewHeight" },
  // ── Zoom: window and editor font ──
  { "key": "cmd+0", "command": "workbench.action.zoomReset" },
  { "key": "cmd+shift+=", "command": "editor.action.fontZoomIn" },
  { "key": "cmd+shift+-", "command": "editor.action.fontZoomOut" },
  { "key": "cmd+shift+0", "command": "editor.action.fontZoomReset" },

  // ════════════════════════════════════════════════════════════════
  // SIDEBARS, PANELS & UI TOGGLES
  // ════════════════════════════════════════════════════════════════
  { "key": "cmd+\\", "command": "workbench.action.toggleSidebarVisibility" },
  { "key": "alt+cmd+1", "command": "workbench.view.extension.tabStack" },
  { "key": "alt+cmd+2", "command": "workbench.view.extension.bookmarks" },
  { "key": "cmd+b", "command": "breadcrumbs.toggle" },
  {
    "key": "cmd+shift+b",
    "command": "workbench.action.toggleActivityBarVisibility",
  },
  { "key": "cmd+m", "command": "editor.action.toggleMinimap" },
  { "key": "cmd+shift+i", "command": "workbench.action.selectIconTheme" },
  // ── Panel position ──
  {
    "key": "ctrl+shift+`",
    "command": "workbench.action.positionPanelRight",
    "when": "panelPosition == 'bottom'",
  },
  {
    "key": "ctrl+shift+`",
    "command": "workbench.action.positionPanelBottom",
    "when": "panelPosition != 'bottom'",
  },

  // ════════════════════════════════════════════════════════════════
  // EXPLORER
  // ════════════════════════════════════════════════════════════════
  // ── Reveal ──
  {
    "key": "cmd+shift+r",
    "command": "workbench.files.action.showActiveFileInExplorer",
  },
  // Collapse all folders, then expand only the path to the current file
  {
    "key": "alt+r",
    "command": "runCommands",
    "args": {
      "commands": [
        "workbench.files.action.collapseExplorerFolders",
        "workbench.files.action.showActiveFileInExplorer",
      ],
    },
  },
  {
    "key": "cmd+r cmd+o",
    "command": "workbench.action.files.revealActiveFileInWindows",
  },
  {
    "key": "cmd+r r",
    "command": "-workbench.action.files.revealActiveFileInWindows",
  },
  // ── Arrow keys preview each file as you move ──
  {
    "key": "down",
    "command": "runCommands",
    "args": {
      "commands": ["list.focusDown", "filesExplorer.openFilePreserveFocus"],
    },
    "when": "filesExplorerFocus && !inputFocus",
  },
  {
    "key": "up",
    "command": "runCommands",
    "args": {
      "commands": ["list.focusUp", "filesExplorer.openFilePreserveFocus"],
    },
    "when": "filesExplorerFocus && !inputFocus",
  },
  // ── Collapse the folder you're in (press again to go up a level) ──
  {
    "key": "ctrl+shift+left",
    "command": "runCommands",
    "args": { "commands": ["list.focusParent", "list.collapse"] },
    "when": "filesExplorerFocus && !inputFocus",
  },
  {
    "key": "ctrl+shift+right",
    "command": "list.expand",
    "when": "filesExplorerFocus && !inputFocus",
  },

  // ════════════════════════════════════════════════════════════════
  // OUTLINE — arrow keys jump to each symbol as you move
  // ════════════════════════════════════════════════════════════════
  {
    "key": "down",
    "command": "runCommands",
    "args": { "commands": ["list.focusDown", "list.selectAndPreserveFocus"] },
    "when": "focusedView == 'outline' && listFocus && !inputFocus",
  },
  {
    "key": "up",
    "command": "runCommands",
    "args": { "commands": ["list.focusUp", "list.selectAndPreserveFocus"] },
    "when": "focusedView == 'outline' && listFocus && !inputFocus",
  },
  // Placeholder: toggle focus between the editor and the Outline
  // { "key": "cmd+shift+o", "command": "outline.focus", "when": "focusedView != 'outline'" },
  // { "key": "cmd+shift+o", "command": "workbench.action.focusActiveEditorGroup", "when": "focusedView == 'outline'" },

  // ════════════════════════════════════════════════════════════════
  // SOURCE CONTROL — arrow keys open each changed file as you move
  // ════════════════════════════════════════════════════════════════
  { "key": "cmd+shift+g", "command": "workbench.view.scm" },
  {
    "key": "down",
    "command": "runCommands",
    "args": { "commands": ["list.focusDown", "list.selectAndPreserveFocus"] },
    "when": "focusedView == 'workbench.scm' && listFocus && !inputFocus",
  },
  {
    "key": "up",
    "command": "runCommands",
    "args": { "commands": ["list.focusUp", "list.selectAndPreserveFocus"] },
    "when": "focusedView == 'workbench.scm' && listFocus && !inputFocus",
  },
  {
    "key": "down",
    "command": "runCommands",
    "args": {
      "commands": [
        "list.focusDown",
        "list.selectAndPreserveFocus",
        "list.expand",
      ],
    },
    "when": "focusedView == 'workbench.scm' && listFocus && !inputFocus",
  },
  {
    "key": "up",
    "command": "runCommands",
    "args": {
      "commands": [
        "list.focusUp",
        "list.selectAndPreserveFocus",
        "list.expand",
      ],
    },
    "when": "focusedView == 'workbench.scm' && listFocus && !inputFocus",
  },
  // Open the diff for the file you're on, instead of the file itself
  {
    "key": "cmd+shift+h",
    "command": "git.openChange",
    "when": "editorTextFocus",
  },

  // ════════════════════════════════════════════════════════════════
  // FOLDING — overrides Vim's ctrl+[ / ctrl+]
  // ════════════════════════════════════════════════════════════════
  // ── At cursor ──
  {
    "key": "ctrl+shift+[",
    "command": "editor.toggleFold",
    "when": "editorTextFocus && foldingEnabled",
  },
  {
    "key": "ctrl+shift+]",
    "command": "editor.toggleFold",
    "when": "editorTextFocus && foldingEnabled",
  },
  {
    "key": "ctrl+[",
    "command": "editor.fold",
    "when": "editorTextFocus && foldingEnabled",
  },
  {
    "key": "ctrl+]",
    "command": "editor.unfold",
    "when": "editorTextFocus && foldingEnabled",
  },
  // ── Whole file ──
  {
    "key": "ctrl+shift+enter",
    "command": "editor.foldAllExcept",
    "when": "editorTextFocus && foldingEnabled",
  },
  {
    "key": "ctrl+\\",
    "command": "editor.unfoldAll",
    "when": "editorTextFocus && foldingEnabled",
  },
  // Placeholders: alt+f now opens Find in Files, ctrl+shift+8/9 are move-to-split
  // { "key": "ctrl+alt+f", "command": "editor.createFoldingRangeFromSelection", "when": "editorTextFocus && editorHasSelection" },
  // { "key": "ctrl+shift+8", "command": "editor.foldAllMarkerRegions", "when": "editorTextFocus && foldingEnabled" },
  // { "key": "ctrl+shift+9", "command": "editor.unfoldAllMarkerRegions", "when": "editorTextFocus && foldingEnabled" },

  // ════════════════════════════════════════════════════════════════
  // EDITING
  // ════════════════════════════════════════════════════════════════
  // ── Emmet: expand / shrink selection to tag ──
  {
    "key": "cmd+shift+up",
    "command": "editor.emmet.action.balanceOut",
    "when": "editorTextFocus",
  },
  {
    "key": "cmd+shift+down",
    "command": "editor.emmet.action.balanceIn",
    "when": "editorTextFocus",
  },
  // ── Inline fold (long strings) ──
  { "key": "ctrl+alt+s", "command": "inlineFold.toggle" },
  // ── Redo on cmd+y instead of shift+cmd+z ──
  {
    "key": "cmd+y",
    "command": "redo",
    "when": "editorTextFocus && !editorReadonly",
  },
  {
    "key": "shift+cmd+z",
    "command": "-redo",
    "when": "editorTextFocus && !editorReadonly",
  },

  // ════════════════════════════════════════════════════════════════
  // TERMINAL
  // ════════════════════════════════════════════════════════════════
  { "key": "ctrl+`", "command": "workbench.action.terminal.toggleTerminal" },
  {
    "key": "cmd+d",
    "command": "workbench.action.terminal.split",
    "when": "terminalFocus",
  },

  // ════════════════════════════════════════════════════════════════
  // BOOKMARKS — any mode (Vim leader versions live in settings.json)
  // ════════════════════════════════════════════════════════════════
  {
    "key": "cmd+alt+shift+b",
    "command": "bookmarks.toggle",
    "when": "editorTextFocus",
  },
  {
    "key": "alt+cmd+b",
    "command": "bookmarks.toggleLabeled",
    "when": "editorTextFocus",
  },
  // Replaces built-in column select left / right
  {
    "key": "cmd+alt+shift+left",
    "command": "bookmarks.jumpToPrevious",
    "when": "editorTextFocus",
  },
  {
    "key": "cmd+alt+shift+right",
    "command": "bookmarks.jumpToNext",
    "when": "editorTextFocus",
  },
  { "key": "alt+cmd+o", "command": "bookmarks.listFromAllFiles" },

  // ════════════════════════════════════════════════════════════════
  // DIAGNOSTICS — coding / review mode toggle
  // ════════════════════════════════════════════════════════════════
  {
    "key": "cmd+shift+alt+e",
    "command": "settings.cycle",
    "args": {
      "id": "toggle-diagnostics",
      "values": [
        {
          "typescript.validate.enable": true,
          "javascript.validate.enable": true,
          "editor.renderValidationDecorations": "on",
        },
        {
          "typescript.validate.enable": false,
          "javascript.validate.enable": false,
          "editor.renderValidationDecorations": "off",
        },
      ],
    },
  },

  // ════════════════════════════════════════════════════════════════
  // MOVED DEFAULTS — frees alt+cmd+b, alt+cmd+o, shift+cmd+v
  // ════════════════════════════════════════════════════════════════
  // ── Secondary sidebar: alt+cmd+b → new chord ──
  {
    "key": "ctrl+alt+cmd+0 ctrl+alt+cmd",
    "command": "workbench.action.toggleAuxiliaryBar",
    "when": "!isAuxiliaryWindowFocusedContext",
  },
  {
    "key": "alt+cmd+b",
    "command": "-workbench.action.toggleAuxiliaryBar",
    "when": "!isAuxiliaryWindowFocusedContext",
  },
  // ── Remote menu and overtype: alt+cmd+o → ctrl+alt+cmd+o ──
  // (both share the new key; the later one, overtype, wins)
  { "key": "ctrl+alt+cmd+o", "command": "workbench.action.remote.showMenu" },
  { "key": "alt+cmd+o", "command": "-workbench.action.remote.showMenu" },
  {
    "key": "ctrl+alt+cmd+o",
    "command": "editor.action.toggleOvertypeInsertMode",
  },
  { "key": "alt+cmd+o", "command": "-editor.action.toggleOvertypeInsertMode" },
  // ── Markdown preview: shift+cmd+v → cmd+r cmd+r ──
  { "key": "cmd+r cmd+r", "command": "markdown.showPreview" },
  {
    "key": "shift+cmd+v",
    "command": "-markdown.showPreview",
    "when": "!notebookEditorFocused && editorLangId == 'markdown'",
  },
]

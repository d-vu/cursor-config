  "vim.showcmd": true,
  "vim.mouseSelectionGoesIntoVisualMode": true,
  "vim.foldfix": true,
  "vim.hlsearch": true,
  "vim.easymotion": true,
  "vim.sneak": true,
  "vim.useSystemClipboard": true,

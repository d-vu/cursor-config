  // ═════════════════════════════════════════════════════════
  // EDITOR
  // ═════════════════════════════════════════════════════════
  "editor.wordWrap": "bounded",
  "editor.wordWrapColumn": 200,
  "editor.renderLineHighlight": "line",
  "editor.semanticHighlighting.enabled": true,
  "editor.occurrencesHighlight": "multiFile",
  "editor.roundedSelection": true,
  "editor.linkedEditing": true,
  "editor.bracketPairColorization.independentColorPoolPerBracketType": true,
  "editor.guides.highlightActiveBracketPair": false,
  // ── Cursor ──
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.cursorWidth": 1,
  "editor.cursorBlinking": "phase",
  // ── Scrolling, scrollbar, minimap ──
  "editor.fastScrollSensitivity": 15,
  "editor.scrollbar.verticalScrollbarSize": 14,
  "editor.overviewRulerBorder": true,
  "editor.hideCursorInOverviewRuler": false,
  "editor.minimap.showSlider": "always",
  "editor.minimap.maxColumn": 80,
  "editor.minimap.markSectionHeaderRegex": "\\bSECTION:\\s*(?<separator>-?)\\s*(?<label>.*)$",
  // ── Indentation & whitespace ──
  "editor.insertSpaces": true,
  "editor.indentSize": "tabSize",
  "editor.tabSize": 2,
  "files.trimTrailingWhitespace": true,
  "editor.renderWhitespace": "all",
  // ── Navigation: go to definition jumps instead of peeking ──
  "editor.definitionLinkOpensInPeek": false,
  "editor.gotoLocation.alternativeDefinitionCommand": "",
  "editor.gotoLocation.alternativeTypeDefinitionCommand": "",
  "editor.gotoLocation.multipleDefinitions": "goto",
  "editor.gotoLocation.multipleTypeDefinitions": "goto",
  // ── Hover & inlay hints ──
  "editor.hover.enabled": true,
  "editor.hover.delay": 500,
  "editor.hover.hidingDelay": 8000,
  "editor.hover.sticky": true,
  "editor.hover.above": false,
  "editor.inlayHints.enabled": "on",
  "debug.inlineValues": true,
  // ── Folding & sticky scroll ──
  "editor.unfoldOnCursorMove": false,
  "editor.stickyScroll.enabled": false,

  // ═════════════════════════════════════════════════════════
  // LANGUAGES & FORMATTING
  // ═════════════════════════════════════════════════════════
  "editor.formatOnSave": true,
  "[typescript][typescriptreact][javascript][javascriptreact][jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "prettier.bracketSameLine": true,
  "typescript.suggest.autoImports": true,
  "typescript.updateImportsOnFileMove.enabled": "always",
  "javascript.updateImportsOnFileMove.enabled": "always",
  "javascript.format.insertSpaceAfterOpeningAndBeforeClosingTemplateStringBraces": true,
  "python.languageServer": "None",

  // ═════════════════════════════════════════════════════════
  // SEARCH & QUICK OPEN
  // ═════════════════════════════════════════════════════════
  "search.showLineNumbers": true,
  "search.smartCase": true,
  "search.seedWithNearestWord": true,
  "search.quickOpen.history.filterSortOrder": "recency",
  "search.quickOpen.includeSymbols": false,
  "workbench.quickOpen.preserveInput": false,
  "search.useIgnoreFiles": true,
  "task.quickOpen.detail": false,
  "search.quickOpen.includeHistory": false,
  "search.exclude": {
    "**/node_modules": true,
    "**/dist": true,
    "**/build": true,
    "**/coverage": true,
    "**/*.test.tsx": true,
    "**/*.snap": true,
    "**/__pycache__": true,
    "**/*.pyc": true,
    "**/.venv": true,
    "**/.pytest_cache": true,
  },

  // ═════════════════════════════════════════════════════════
  // WORKBENCH & WINDOW
  // ═════════════════════════════════════════════════════════
  "workbench.sideBar.location": "right",
  "workbench.reduceMotion": "on",
  "workbench.enableExperiments": false,
  "workbench.view.showQuietly": {
    "workbench.panel.output": false,
  },
  "workbench.agentsWindowButton.enabled": false,
  "security.promptForLocalFileProtocolHandling": false,
  // ── Title bar ──
  "window.titleBarStyle": "custom",
  "window.title": "${activeEditorShort}",
  "window.titleSeparator": " → ",
  "window.commandCenter": true,
  "workbench.layoutControl.enabled": true,
  // ── Window ──
  "window.zoomPerWindow": false,
  "window.autoDetectColorScheme": false,
  // ── Tabs ──
  "workbench.editor.enablePreviewFromQuickOpen": true,
  "workbench.editor.enablePreviewFromCodeNavigation": true,
  "workbench.editor.decorations.colors": false,
  "workbench.editor.decorations.badges": false,
  "workbench.editor.highlightModifiedTabs": true,
  "workbench.editor.pinnedTabsOnSeparateRow": true,
  "workbench.editor.revealIfOpen": true,
  "workbench.editor.wrapTabs": true,
  // ── Lists & trees (Explorer filter, Outline, pickers) ──
  "workbench.list.defaultFindMatchType": "contiguous",
  "workbench.list.defaultFindMode": "filter",
  "workbench.tree.indent": 14,
  "workbench.tree.renderIndentGuides": "always",

  // ═════════════════════════════════════════════════════════
  // EXPLORER
  // ═════════════════════════════════════════════════════════
  "explorer.confirmDelete": false,
  "explorer.confirmDragAndDrop": false,
  "explorer.openEditors.visible": 5,
  "explorer.fileNesting.patterns": {
    "*.ts": "${capture}.js, ${capture}.d.ts, ${capture}.test.ts",
    "*.js": "${capture}.js.map, ${capture}.min.js, ${capture}.d.ts",
    "*.jsx": "${capture}.js",
    "*.tsx": "${capture}.test.tsx, ${capture}.stories.tsx",
    "tsconfig.json": "tsconfig.*.json",
    "package.json": "package-lock.json, yarn.lock, pnpm-lock.yaml, .npmrc",
    ".env": ".env.*, .envrc",
    "*.css": "${capture}.module.css",
    "*.sqlite": "${capture}.${extname}-*",
    "*.db": "${capture}.${extname}-*",
    "*.sqlite3": "${capture}.${extname}-*",
    "*.db3": "${capture}.${extname}-*",
    "*.sdb": "${capture}.${extname}-*",
    "*.s3db": "${capture}.${extname}-*",
  },

  // ═════════════════════════════════════════════════════════
  // BREADCRUMBS & OUTLINE
  // ═════════════════════════════════════════════════════════
  "breadcrumbs.symbolPath": "on",
  // Shown
  "breadcrumbs.showFunctions": true,
  "breadcrumbs.showVariables": true,
  "breadcrumbs.showConstants": true,
  "breadcrumbs.showClasses": true,
  "breadcrumbs.showMethods": true,
  "breadcrumbs.showInterfaces": true,
  // Hidden
  "breadcrumbs.showArrays": false,
  "breadcrumbs.showBooleans": false,
  "breadcrumbs.showEnums": false,
  "breadcrumbs.showEnumMembers": false,
  "breadcrumbs.showConstructors": false,
  "breadcrumbs.showFields": false,
  "breadcrumbs.showKeys": false,
  "breadcrumbs.showNull": false,
  "breadcrumbs.showNumbers": false,
  "breadcrumbs.showObjects": false,
  "breadcrumbs.showStrings": false,
  "breadcrumbs.showStructs": false,
  "breadcrumbs.showTypeParameters": false,
  "breadcrumbs.showEvents": false,
  "breadcrumbs.showOperators": false,
  "breadcrumbs.showPackages": false,
  "breadcrumbs.showModules": false,
  "breadcrumbs.showNamespaces": false,
  "outline.icons": true,
  "outline.showProperties": false,
  "outline.showInterfaces": false,
  "outline.showEnumMembers": false,
  "outline.collapseItems": "alwaysCollapse",

  // ═════════════════════════════════════════════════════════
  // TERMINAL
  // ═════════════════════════════════════════════════════════
  "terminal.integrated.defaultLocation": "editor",
  "terminal.integrated.cursorStyle": "line",
  "terminal.integrated.cursorBlinking": true,
  "terminal.integrated.cursorWidth": 1,
  "terminal.integrated.mouseWheelZoom": true,
  "terminal.integrated.enableMultiLinePasteWarning": "never",
  "git.openDiffOnClick": false,
  // ── Source Control view ──
  "scm.defaultViewMode": "tree",
  "scm.defaultViewSortKey": "path",
  "scm.autoReveal": true,
  // ── Diff & GitLens ──
  "diffEditor.renderSideBySide": true,
  "diffEditor.ignoreTrimWhitespace": false,
  "gitlens.plusFeatures.enabled": false,
  "gitlens.currentLine.enabled": false,
  "gitlens.views.branches.files.layout": "list",
  "gitlens.views.branches.branches.layout": "list",
  "gitlens.graph.details.location": "auto",
  "gitlens.statusBar.enabled": true,

  // ═════════════════════════════════════════════════════════
  // ZEN MODE, SCREENCAST & ACCESSIBILITY
  // ═════════════════════════════════════════════════════════
  "zenMode.centerLayout": true,
  "zenMode.fullScreen": false,
  "zenMode.showTabs": "none",
  "zenMode.hideActivityBar": false,
  "zenMode.hideStatusBar": false,
  "zenMode.hideLineNumbers": false,
  "screencastMode.verticalOffset": 2,
  "screencastMode.fontSize": 20,
  "screencastMode.mouseIndicatorColor": "#00000000",
  "screencastMode.keyboardOverlayTimeout": 5000,
  "accessibility.dimUnfocused.enabled": false,
  "accessibility.accessibleView.closeOnKeyPress": false,
  "accessibility.windowTitleOptimized": false,
  "accessibility.signalOptions.volume": 5,

  // ═════════════════════════════════════════════════════════
  // VIM
  // ═════════════════════════════════════════════════════════
  "vim.disableExtension": false,
  "vim.startInInsertMode": false,
  "vim.leader": "<space>",
  "vim.useSystemClipboard": true,
  "vim.showcmd": true,
  "vim.ignorecase": true,
  "vim.smartcase": true,
  "vim.hlsearch": true,
  "vim.foldfix": true,
  "vim.sneak": true,
  "vim.easymotion": false,
  "vim.mouseSelectionGoesIntoVisualMode": false,
  "vim.handleKeys": {
    "<D-S-[>": false,
    "<D-d>": false,
    "<D-S-]>": false,
    "<D-c>": false,
    "<C-c>": false,
  },
  // Status bar color per mode (written to the unscoped statusBar.* above)
  "vim.statusBarColorControl": true,
  "vim.statusBarColors.normal": ["#22212c", "#a0aac8"],
  "vim.statusBarColors.insert": ["#32634a", "#8aff80"],
  "vim.statusBarColors.visual": ["#2d2415", "#ffca80"],
  "vim.statusBarColors.visualline": ["#2d2415", "#ffca80"],
  "vim.statusBarColors.visualblock": ["#2d1e14", "#ff9580"],
  "vim.statusBarColors.replace": ["#2d1522", "#ff92df"],
  "vim.statusBarColors.searchinprogressmode": ["#15202d", "#92a2d4"],
  "vim.normalModeKeyBindingsNonRecursive": [
    // Folding
    { "before": ["z", "j"], "commands": ["editor.gotoNextFold"] },
    { "before": ["z", "k"], "commands": ["editor.gotoPreviousFold"] },
    { "before": ["z", "1"], "commands": ["editor.foldLevel1"] },
    { "before": ["z", "2"], "commands": ["editor.foldLevel2"] },
    { "before": ["z", "3"], "commands": ["editor.foldLevel3"] },
    { "before": ["z", "4"], "commands": ["editor.foldLevel4"] },
    { "before": ["z", "0"], "commands": ["editor.unfoldAll"] },
    // Code navigation
    { "before": ["g", "y"], "commands": ["editor.action.peekDefinition"] },
    {
      "before": ["g", "D"],
      "commands": ["editor.action.revealDefinitionAside"],
    },
    {
      "before": ["g", "R"],
      "commands": ["editor.action.referenceSearch.trigger"],
    },
    { "before": ["g", "r"], "commands": ["references-view.findReferences"] },
    // Bookmarks
    { "before": ["<leader>", "b"], "commands": ["bookmarks.toggle"] },
    { "before": ["<leader>", "B"], "commands": ["bookmarks.toggleLabeled"] },
    { "before": ["<leader>", "<right>"], "commands": ["bookmarks.jumpToNext"] },
    {
      "before": ["<leader>", "<left>"],
      "commands": ["bookmarks.jumpToPrevious"],
    },
    { "before": ["<leader>", "o"], "commands": ["bookmarks.listFromAllFiles"] },
    { "before": ["<leader>", "c"], "commands": ["bookmarks.clear"] },
    {
      "before": ["<leader>", "C"],
      "commands": ["bookmarks.clearFromAllFiles"],
    },
    // Easymotion jumps (inactive while vim.easymotion is false)
    { "before": ["Q"], "after": ["<leader>", "<leader>", "w"] },
    { "before": ["X"], "after": ["<leader>", "<leader>", "b"] },
  ],

  // ═════════════════════════════════════════════════════════
  // BOOKMARKS
  // ═════════════════════════════════════════════════════════
  "bookmarks.navigateThroughAllFiles": true,
  "bookmarks.saveBookmarksInProject": true,
  "bookmarks.wrapNavigation": true,
  "bookmarks.showBookmarkDecorationsInDebugMode": false,
  "bookmarks.confirmClear": "always",

  // ═════════════════════════════════════════════════════════
  // AI (CURSOR & CLAUDE CODE)
  // ═════════════════════════════════════════════════════════
  "cursor.cpp.disabledLanguages": [
    "markdown",
    "plaintext",
    "typescriptreact",
    "typescript",
  ],
  "claudeCode.preferredLocation": "panel",
  "claudeCode.hideOnboarding": true,

  // ═════════════════════════════════════════════════════════
  // REMOTE SSH
  // ═════════════════════════════════════════════════════════
  "remote.SSH.remotePlatform": {
    "daniel-macbook-pro": "macOS",
    "daniels-macbook-pro": "macOS",
    "daniels-macbook-pro.tail1c869e.ts.net": "macOS",
    "dvu_laptop_table": "macOS",
  },

  // ═════════════════════════════════════════════════════════
  // EXTENSIONS
  // ═════════════════════════════════════════════════════════
  // ── Peacock (border colors live in COLORS) ──
  "peacock.affectActivityBar": false,
  "peacock.affectTitleBar": false,
  "peacock.affectStatusBar": false,
  "peacock.affectSashHover": false,
  "peacock.affectWindowBorder": true,

  // ── tailwind-fold ──
  "tailwind-fold.autoFold": false,
  "tailwind-fold.unfoldIfLineSelected": true,
  "tailwind-fold.foldedText": "",
  "tailwind-fold.foldedTextColor": "#7FC9A8",
  "tailwind-fold.foldedTextBackgroundColor": "#282A36",

  // ── inline-fold (long strings) ──
  "inlineFold.regex": "(['\"`])(.{45,}?)(\\1)",
  "inlineFold.regexGroup": "2",
  "inlineFold.supportedLanguages": [
    "typescript",
    "typescriptreact",
    "javascript",
    "javascriptreact",
  ],
  "inlineFold.togglePerFile": false,
  "inlineFold.maskChar": "...",
  "inlineFold.maskColor": "#d8d179",

  // ── Tab Stack ──
  "tabStack.appearance.tabKindColors": [
    { "kind": "tabInputText", "color": "#2472c8" },
    { "kind": "tabInputTextDiff", "color": "#f44747" },
    { "kind": "tabInputCustom", "color": "#c586c0" },
    { "kind": "tabInputWebview", "color": "#2aa198" },
    { "kind": "tabInputNotebook", "color": "#16825d" },
    { "kind": "tabInputNotebookDiff", "color": "#c19c00" },
    { "kind": "tabInputTerminal", "color": "#3b8eea" },
    { "kind": "unknown", "pattern": "^Settings$", "color": "#8F38E5" },
    { "kind": "unknown", "pattern": "^Extensions$", "color": "#c586c0" },
    { "kind": "unknown", "pattern": "^Welcome$", "color": "#F5276C" },
    {
      "kind": "tabInputWebview",
      "pattern": "^Release Notes: [0-9.]+$",
      "color": "#82E8E8",
    },
  ],
  "tabStack.statusBar.visible": false,

  // ── Todo list ──
  "vscodeTodo.createPosition": "bottom",
  "vscodeTodo.enableLineNumbers": true,

  // ── Date & time (status bar clock) ──
  "dateTime.showAMPM": true,
  "dateTime.showSeconds": true,
  "dateTime.showDayOfMonth": true,
  "dateTime.showDayOfWeek": true,
  "dateTime.showMonth": true,
  "dateTime.use24HourClock": false,
  "dateTime.padDays": true,
  "dateTime.padHours": false,

  // ── Background (faint grid behind code) ──
  "background.enabled": false,
  "background.editor": {
    "useFront": true,
    "style": {
      "background-position": "0px 0px",
      "background-size": "cover",
      "opacity": 0.03,
    },
    "images": [
      "data:image/svg+xml;base64,",
    ],
    "interval": 0,
    "random": false,
  },

  // ── Spell check ──
  "cSpell.enabled": true,
  "cSpell.userWords": [
    "braintrust",
    "evals",
    "excalidraw",
    "Favorited",
    "nums",
    "Priya",
    "pyrefly",
    "pytest",
    "pythonpath",
    "repointing",
    "TAVILY",
    "testpaths",
    "unstub",
    "venv",
  ],

  // ── Misc ──
  "better-comments.highlightPlainText": true,
  "totalTypeScript.hideAllTips": true,
  "vscode-pets.petType": "dog",
  "vscode-pets.petColor": "warrior",
  "vscode-pets.petSize": "medium",
  "vscode-pets.theme": "autumn",
  "vscode-pets.throwBallWithMouse": true,
  "gitBrain.telemetry.enabled": false,
  "excalidraw.language": "en",
  "excalidraw.theme": "dark",
  "explorer.sortOrderLexicographicOptions": "lower",
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.expand": false,
  "explorer.sortOrder": "modified",
  "eyecons.hidesExplorerArrows": false,
  "symbols.hidesExplorerArrows": false,
  "editor.accessibilitySupport": "off",
  "find-it-faster.general.batTheme": "Dracula",
  "find-it-faster.general.openFileInPreviewEditor": true,
  "find-it-faster.general.useTerminalInEditor": true,
}

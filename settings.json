{
  // ═════════════════════════════════════════════════════════
  // DIAGNOSTICS MODE — flip comments to switch
  // ═════════════════════════════════════════════════════════
  // ── Coding (quiet) ──
  // "typescript.validate.enable": false,
  // "javascript.validate.enable": false,
  // "editor.renderValidationDecorations": "off",
  // "errorLens.enabled": false,
  // "eslint.enable": false,
  // "editor.showUnused": false,
  // "editor.showDeprecated": false,
  // "problems.decorations.enabled": false,
  // ── Review (full diagnostics) ──
  "typescript.validate.enable": true,
  "javascript.validate.enable": true,
  "editor.renderValidationDecorations": "on",
  "errorLens.enabled": true,
  "eslint.enable": true,
  "editor.showUnused": true,
  "editor.showDeprecated": true,
  "problems.decorations.enabled": true,

  // ═════════════════════════════════════════════════════════
  // THEME, ICONS & FONTS
  // ═════════════════════════════════════════════════════════
  "workbench.colorTheme": "Dracula Theme Soft",
  "workbench.iconTheme": "simple-icons",
  "workbench.productIconTheme": "fluent-icons",
  "editor.fontSize": 14,
  "editor.lineHeight": 1.55,
  // "editor.fontFamily": "JetBrains Mono, monospace",
  // // Alternates:
  "editor.fontFamily": "DejaVu Sans Mono, monospace",
  // // "editor.fontFamily": "Inter, monospace",
  // "editor.fontFamily": "Google Sans Code",
  // "editor.fontFamily": "Geist Mono, monospace",
  // "editor.fontFamily": "Maple Mono, monospace",
  // "editor.fontFamily": "Ubuntu Mono, monospace",
  // "editor.fontFamily": "Cascadia Code, monospace",
  // "editor.fontFamily": "Monaspace Neon, monospace",
  // "editor.fontFamily": "Monaspace Radon, monospace",
  "editor.fontLigatures": true,
  "terminal.integrated.fontFamily": "JetBrainsMono Nerd Font",
  "terminal.integrated.fontSize": 14,

  // ═════════════════════════════════════════════════════════
  // COLORS — scoped to [Dracula Theme Soft]
  // Unscoped exceptions: window borders (Peacock) and statusBar.*
  // (Vim rewrites them per mode; scoped keys would mask that).
  // Same role = same color in TS/JS and Python.
  // ═════════════════════════════════════════════════════════

  // ── Semantic tokens (language server; wins over TextMate) ──
  "editor.semanticTokenColorCustomizations": {
    "[Dracula Theme Soft]": {
      "rules": {
        "function.defaultLibrary": { "foreground": "#6ccf8d" },
        "method": { "foreground": "#6ccf8d" },
        "class": { "foreground": "#5cc9b5", "italic": false },
        "class.defaultLibrary": { "foreground": "#e0b088", "italic": false },
        "variable.declaration": { "foreground": "#b9a3ee" },
        "variable.declaration.local": { "foreground": "#b9a3ee" },
        "variable.declaration.readonly": { "foreground": "#b9a3ee" },
        "variable.declaration.readonly.local": { "foreground": "#b9a3ee" },
        "variable.readonly": { "foreground": "#a3c0ee" },
        "variable.local": { "foreground": "#a3c0ee" },
        "variable.readonly.local": { "foreground": "#a3c0ee" },
        "parameter": { "foreground": "#ffb86c", "italic": false },
        "parameter.declaration": { "foreground": "#ffb86c", "italic": true },
        "property": { "foreground": "#d0d5ef" },
        "type": { "foreground": "#e0b088" },
        "typeParameter": { "foreground": "#e0b088" },
        "interface": { "foreground": "#e0b088", "italic": false },
        "enum": { "foreground": "#5cc9b5", "bold": true },
        "namespace": { "foreground": "#b9a3ee" },

        // ── Python only ──
        "variable:python": { "foreground": "#a3c0ee" },
        "function:python": { "foreground": "#6ccf8d" },
        "selfParameter:python": { "foreground": "#f286c4" },
        "clsParameter:python": { "foreground": "#f286c4" },
        "decorator:python": { "foreground": "#5cc9b5" },
      },
    },
  },

  // ── TextMate tokens (grammar; fallback under semantic) ──
  // Keep hexes in sync with the semantic rules to avoid flicker.
  "editor.tokenColorCustomizations": {
    "[Dracula Theme Soft]": {
      "textMateRules": [
        {
          "scope": [
            "variable",
            "support.variable.property",
            "variable.other.constant.js",
            "variable.other.constant.ts",
            "variable.other.constant.tsx",
            "meta.import variable.other.readwrite.alias",
            "meta.export variable.other.readwrite.alias",
            "meta.brace.round",
            "meta.function-call punctuation",
            "punctuation.definition.arguments.begin",
            "punctuation.definition.arguments.end",
            "punctuation.definition.entity.begin",
            "punctuation.definition.entity.end",
            "punctuation.definition.type.begin",
            "punctuation.definition.type.end",
            "punctuation.section.scope.begin",
            "punctuation.section.scope.end",
            "string.template meta.brace",
            "string.template punctuation.accessor",
            "storage.modifier.import",
            "punctuation.section.embedded.begin.tsx",
            "punctuation.section.embedded.end.tsx",
            "punctuation.section.embedded.begin.jsx",
            "punctuation.section.embedded.end.jsx",
            "punctuation.separator.list.comma.css",
            "invalid.deprecated",
          ],
          "settings": { "foreground": "#d0d5ef" },
        },
        {
          "scope": [
            "support.function",
            "entity.name.function",
            "meta.function-call.generic.python",
            "support.function.magic.python",
          ],
          "settings": { "foreground": "#6ccf8d" },
        },
        {
          "scope": [
            "entity.name.type",
            "entity.name.type.type-parameter",
            "meta.type.parameters entity.name.type",
          ],
          "settings": { "foreground": "#e0b088", "fontStyle": "" },
        },
        {
          "scope": [
            "entity.name.type.class",
            "entity.other.inherited-class",
            "entity.name.type.enum",
          ],
          "settings": { "foreground": "#5cc9b5", "fontStyle": "" },
        },
        {
          "scope": [
            "support.type.primitive",
            "support.type.builtin",
            "support.class.builtin",
            "support.type.exception",
            "support.type.python",
          ],
          "settings": { "foreground": "#e0b088", "fontStyle": "" },
        },
        {
          "scope": [
            "variable.other.readwrite",
            "variable.other.constant.object",
            "variable.other.object",
            "constant.other.caps.python",
          ],
          "settings": { "foreground": "#a3c0ee" },
        },
        {
          "scope": [
            "variable.other.property",
            "variable.other.object.property",
            "support.constant.property",
            "support.variable.property",
            "meta.object-literal.key",
            "support.type.property-name",
            "meta.attribute.python",
          ],
          "settings": { "foreground": "#d0d5ef" },
        },
        {
          "scope": [
            "variable.language.this.ts",
            "meta.object.member",
            "punctuation.accessor.tsx",
            "punctuation.accessor.optional.tsx",
          ],
          "settings": { "foreground": "#f286c4" },
        },
        {
          "scope": [
            "variable.language.special.self.python",
            "variable.language.special.cls.python",
            "variable.parameter.function.language.special.self.python",
            "variable.parameter.function.language.special.cls.python",
          ],
          "settings": { "foreground": "#f286c4", "fontStyle": "" },
        },
        {
          "scope": [
            "constant.language.boolean.true",
            "constant.language.boolean.false",
            "constant.language.null",
            "constant.language.undefined",
            "constant.language.python",
            "constant.numeric.decimal",
            "constant.numeric",
          ],
          "settings": { "foreground": "#a9d672" },
        },
        {
          "scope": ["variable.parameter"],
          "settings": { "foreground": "#ffb86c" },
        },
        {
          "scope": [
            "keyword.control.flow",
            "storage.modifier.async",
            "storage.type.function.async.python",
          ],
          "settings": { "foreground": "#f286c4", "fontStyle": "bold" },
        },
        {
          "scope": ["support.class.component", "support.class.component.tsx"],
          "settings": { "foreground": "#6ccf8d" },
        },
        {
          "scope": [
            "string",
            "punctuation.definition.string.begin",
            "punctuation.definition.string.end",
          ],
          "settings": { "foreground": "#d8d179" },
        },
        {
          "scope": [
            "entity.other.attribute-name.tsx",
            "entity.other.attribute-name.jsx",
          ],
          "settings": { "foreground": "#5cc9b5" },
        },
        {
          "scope": ["variable.parameter.function-call.python"],
          "settings": { "foreground": "#ffb86c" },
        },
        {
          "scope": ["meta.jsx.children.tsx", "meta.jsx.children.js"],
          "settings": { "foreground": "#d5ccd7" },
        },
        {
          "scope": [
            "comment",
            "comment.block.documentation",
            "punctuation.definition.comment",
            "string.quoted.docstring.multi",
            "string.quoted.docstring.multi.python punctuation.definition.string.begin",
            "string.quoted.docstring.multi.python punctuation.definition.string.end",
          ],
          "settings": { "foreground": "#8388b3" },
        },
        {
          "scope": [
            "meta.function.decorator.python",
            "entity.name.function.decorator.python",
            "meta.function.decorator.python support.type.python",
          ],
          "settings": { "foreground": "#5cc9b5" },
        },
        { "scope": ["source.python"], "settings": { "foreground": "#a3c0ee" } },
        {
          "scope": ["meta.function.python"],
          "settings": { "foreground": "#5cc9b5" },
        },
        {
          "scope": [
            "punctuation.definition.arguments.begin.python",
            "punctuation.definition.arguments.end.python",
            "punctuation.definition.dict.begin.python",
            "punctuation.definition.dict.end.python",
            "punctuation.definition.inheritance.begin.python",
            "punctuation.definition.inheritance.end.python",
            "punctuation.definition.list.begin.python",
            "punctuation.definition.list.end.python",
            "punctuation.definition.parameters.begin.python",
            "punctuation.definition.parameters.end.python",
            "punctuation.parenthesis.begin.python",
            "punctuation.parenthesis.end.python",
            "punctuation.section.class.begin.python",
            "punctuation.section.function.begin.python",
            "punctuation.separator.arguments.python",
            "punctuation.separator.colon.python",
            "punctuation.separator.dict.python",
            "punctuation.separator.element.python",
            "punctuation.separator.parameters.python",
            "punctuation.separator.period.python",
            "punctuation.separator.inheritance.python",
            "punctuation.section.function.lambda.begin.python",
          ],
          "settings": { "foreground": "#d0d5ef" },
        },
        {
          "scope": [
            "punctuation.separator.annotation.python",
            "constant.character.format.placeholder.other.python",
          ],
          "settings": { "foreground": "#f286c4" },
        },
        // Strips italics only — no foreground, so the rules above keep their colors
        {
          "scope": [
            "entity.name.type",
            "meta.type.annotation.ts",
            "support.class.component.tsx",
            "entity.other.attribute-name.tsx",
            "variable.parameter.function-call.python",
            "variable.language.this",
            "keyword.operator.new.tsx",
          ],
          "settings": { "fontStyle": "" },
        },
      ],
    },
  },

